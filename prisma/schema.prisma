generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

// Config global chave/valor (ex.: tokens fixos dos links do designer).
model Setting {
  key   String @id
  value String
}

model Client {
  id            String        @id @default(cuid())
  name          String
  email         String?
  whatsapp      String?
  createdAt     DateTime      @default(now())
  token         String?       @unique @default(uuid())
  internalToken String?       @unique @default(dbgenerated("gen_random_uuid()"))
  coverToken    String?       @unique @default(dbgenerated("gen_random_uuid()"))
  roteiroClienteId String?    // id do rot_clientes no sistema de Roteirização
  campaigns     Campaign[]
  contentItems  ContentItem[]
}

model Campaign {
  id                  String               @id @default(cuid())
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  month               Int
  year                Int
  token               String               @unique @default(uuid())
  internalToken       String               @unique @default(dbgenerated("gen_random_uuid()"))
  expiresAt           DateTime
  status              String               @default("DRAFT")
  lastChargedAt       DateTime?
  sentToProduction    Boolean              @default(false)
  createdAt           DateTime             @default(now())
  contentItems        ContentItem[]
  approvalItems       ApprovalItem[]
  internalReviewItems InternalReviewItem[]
}

model ContentItem {
  id                 String              @id @default(cuid())
  campaignId         String?
  campaign           Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fileUrl            String
  fileType           String
  title              String?
  caption            String?
  scheduledDate      DateTime?
  contentType        String
  groupId            String?
  driveUrl           String?
  coverUrl           String?
  coverDriveUrl      String?
  order              Int                 @default(0)
  postedAt           DateTime?
  sentToProgramacaoAt DateTime?
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status             String              @default("DRAFT")
  roteiroConteudoId  String?             // id do rot_conteudos no sistema de Roteirização
  asanaUrl           String?             // link da tarefa no Asana (opcional)
  coverWaived        Boolean             @default(false) // vídeo liberado p/ programar sem capa
  coverApproved      Boolean             @default(false) // capa aprovada na etapa "Aprovar capa"
  createdAt          DateTime            @default(now())
  approvalItem       ApprovalItem?
  internalReviewItem InternalReviewItem?
  adjustmentHistory  AdjustmentHistory[]
}

// Histórico de ajustes/reprovações pedidos (cliente ou interno). Diferente dos
// campos clientComment/comment (que são limpos ao avançar), aqui cada pedido fica
// registrado para consulta ("o que já foi pedido neste post").
model AdjustmentHistory {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  source        String      // "CLIENTE" | "INTERNO"
  status        String      // "ADJUSTMENT" | "REJECTED"
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([contentItemId])
}

model InternalReviewItem {
  id              String      @id @default(cuid())
  contentItemId   String      @unique
  contentItem     ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status          String      @default("PENDING")
  comment         String?
  commentResolved Boolean     @default(false)
  reviewedAt      DateTime?
  createdAt       DateTime    @default(now())
}

model ApprovalItem {
  id                    String      @id @default(cuid())
  contentItemId         String      @unique
  contentItem           ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  campaignId            String?
  campaign              Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status                String      @default("PENDING")
  clientComment         String?
  clientCommentResolved Boolean     @default(false)
  reviewedAt            DateTime?
  createdAt             DateTime    @default(now())
}

// Config editável: responsável no Roteirização por fase da aprovação.
model ResponsavelRoteiro {
  chave String @id
  nome  String
}
